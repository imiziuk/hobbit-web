# Copy to .env and edit.
# Folder of YOUR installed game (contains Meridian.exe and common.DFS). Forward slashes work on Windows.
GAME_DIR=C:/Games/The Hobbit
# Where the multiplayer relay listens on this machine. 0.0.0.0 = every network (LAN + Tailscale).
# Use your Tailscale IP (e.g. 100.x.y.z) to accept friends only through Tailscale.
RELAY_BIND=0.0.0.0
