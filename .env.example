# Copy to .env and edit.
# Folder of YOUR installed game (contains Meridian.exe and common.DFS). Forward slashes work on Windows.
GAME_DIR=C:/Games/The Hobbit
# Optional Tailscale auth key (admin console > Settings > Keys). Leave empty to log in once with the link printed by
# `docker logs hobbit-tailscale`.
TS_AUTHKEY=
