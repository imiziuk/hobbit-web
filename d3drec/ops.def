# ---------------------------------------------------------------- meta records (no `this`)
# SHOT: frame, width, height, scale (downscale factor), source back-buffer format, RGBA8 pixels (w*h*4, top row first)
192 Meta::Shot                        uuuudB
# DESTROY: a wrapped object's real refcount reached 0 (or its container died)
193 Meta::Destroy                     u
# EVENT: free text (warnings, stats, first-chance exceptions)
194 Meta::Event                       s
# END: frames, total calls (written on device release, DLL unload and crash flush)
195 Meta::End                         uu
# OBJECT: an object handed out that the recorder does not wrap (cube/volume textures, swap chains): id 0 in records
196 Meta::Unwrapped                   ds
# CREATE: Direct3DCreate8(sdkVersion) returned the IDirect3D8 with this id
197 Meta::Create                      uu
# HR prefix: the NEXT record's call returned this HRESULT (only written when it is not S_OK)
240 Meta::HR                          d
